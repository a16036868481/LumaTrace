{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaTrace",
  "version": "0.1.0",
  "identifier": "dev.lumatrace.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri-frontend",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LumaTrace",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": [
      "binaries/lumatrace-local-server"
    ],
    "resources": [
      "binaries/sidecar-manifest.json",
      "binaries/packaging-notices.json",
      "binaries/THIRD-PARTY-NOTICES.md",
      "binaries/lumatrace-local-server-runtime"
    ]
  }
}
